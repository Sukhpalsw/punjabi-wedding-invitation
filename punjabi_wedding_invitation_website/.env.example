# Copy this file to ".env" for local `netlify dev` testing only.
# ".env" is gitignored — never commit your real password.
#
# In production (Netlify dashboard), this must be set under:
# Site settings -> Environment variables -> PROTECTED_PAGE_PASSWORD
# It is read by netlify/edge-functions/auth-gate.js and is never
# written into any HTML/CSS/JS file.

PROTECTED_PAGE_PASSWORD=
