# Copy this file to ".env" for local `netlify dev` testing only.
# ".env" is gitignored — never commit your real passwords.
#
# In production (Netlify dashboard), these must be set under:
# Site settings -> Environment variables
# Both are read by netlify/edge-functions/auth-gate.js and are never
# written into any HTML/CSS/JS file. If either is missing, the site
# fails closed (nobody gets in, including the owner) rather than
# serving unprotected or single-tier access.
#
# NORMAL_GUEST_PASSWORD  -> grants the standard invitation (access level "normal")
# SPECIAL_GUEST_PASSWORD -> grants the full invitation, including the
#                           extra family-only events (access level "special")

NORMAL_GUEST_PASSWORD=
SPECIAL_GUEST_PASSWORD=

# Read by netlify/functions/rsvp-notify.js — turns a verified RSVP
# submission into a push notification via ntfy (https://ntfy.sh).
#
# NTFY_TOPIC     (required for notifications to send) the ntfy topic to
#                publish to, e.g. GoldenSeal-RSVP. Treat this like a
#                shared secret: anyone who knows it can publish to (and
#                by default, subscribe to) that topic.
# NTFY_SERVER    (optional) only needed if self-hosting ntfy instead of
#                using the public https://ntfy.sh.
# WEBHOOK_SECRET (optional) if set, must exactly match the "Secret"
#                field on the same Outgoing webhook notification in the
#                Netlify dashboard — enables verifying that submissions
#                genuinely came from Netlify before notifying. Safe to
#                leave unset; the notification still works either way.

NTFY_TOPIC=
NTFY_SERVER=
WEBHOOK_SECRET=
